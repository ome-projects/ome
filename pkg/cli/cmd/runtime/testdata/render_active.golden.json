{
  "apiVersion": "cli.ome.io/v1alpha1",
  "kind": "RenderedInferenceService",
  "metadata": {
    "name": "service",
    "namespace": "team-a"
  },
  "view": "Active",
  "sources": [
    {
      "kind": "InferenceService",
      "name": "team-a/service",
      "origin": "Cluster"
    },
    {
      "kind": "ClusterServingRuntime",
      "name": "cluster-runtime",
      "origin": "Cluster"
    },
    {
      "kind": "ControllerRevision",
      "name": "control-plane/cr-cluster-runtime-e0e2b0d6",
      "origin": "Cluster"
    },
    {
      "kind": "ConfigMap",
      "name": "control-plane/inferenceservice-config",
      "origin": "Cluster"
    }
  ],
  "deployDefaults": "Applied",
  "components": {
    "engine": {
      "deploymentMode": "RawDeployment",
      "deploymentModeSource": "Default",
      "spec": {
        "volumes": [
          {
            "name": "runtime-secret",
            "secret": {
              "secretName": "secret-volume-ref-name-canary"
            }
          }
        ],
        "terminationGracePeriodSeconds": 45,
        "minReplicas": 2,
        "maxReplicas": 6,
        "runner": {
          "name": "runner",
          "image": "private.registry.invalid/runtime:credential-canary",
          "args": [
            "--token=secret-argument-canary"
          ],
          "env": [
            {
              "name": "TOKEN",
              "value": "secret-environment-canary"
            },
            {
              "name": "SECRET_KEY",
              "valueFrom": {
                "secretKeyRef": {
                  "name": "secret-key-ref-name-canary",
                  "key": "secret-key-ref-key-canary"
                }
              }
            }
          ],
          "resources": {}
        }
      }
    }
  }
}
