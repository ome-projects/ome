  {
    "name": "metrics aggregation and scraping on",
    "pod": {
      "metadata": {
        "annotations": {
          "ome.io/enable-metric-aggregation": "true",
          "ome.io/enable-prometheus-scraping": "true",
          "prometheus.io/path": "/metrics",
          "prometheus.io/port": "9088"
        }
      },
      "spec": {
        "containers": [
          {
            "name": "ome-container",
            "resources": {}
          },
          {
            "name": "queue-proxy",
            "ports": [
              {
                "name": "http-usermetric",
                "containerPort": 9091,
                "protocol": "TCP"
              },
              {
                "name": "aggr-metric",
                "containerPort": 9088,
                "protocol": "TCP"
              }
            ],
            "env": [
              {
                "name": "CONTAINER_PROMETHEUS_METRICS_PORT",
                "value": "8080"
              },
              {
                "name": "CONTAINER_PROMETHEUS_METRICS_PATH",
                "value": "/metrics"
              },
              {
                "name": "AGGREGATE_PROMETHEUS_METRICS_PORT",
                "value": "9088"
              }
            ],
            "resources": {}
          }
        ]
      },
      "status": {}
    }
