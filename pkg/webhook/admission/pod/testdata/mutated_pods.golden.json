[
  {
    "name": "rdma default profile",
    "pod": {
      "metadata": {
        "annotations": {
          "ome.io/enable-metric-aggregation": "false",
          "ome.io/enable-prometheus-scraping": "false",
          "rdma.ome.io/auto-inject": "true"
        }
      },
      "spec": {
        "volumes": [
          {
            "name": "dshm",
            "emptyDir": {
              "medium": "Memory"
            }
          },
          {
            "name": "devinf",
            "hostPath": {
              "path": "/dev/infiniband"
            }
          }
        ],
        "containers": [
          {
            "name": "ome-container",
            "env": [
              {
                "name": "NCCL_DEBUG",
                "value": "INFO"
              },
              {
                "name": "NCCL_IB_HCA",
                "value": "=mlx5_0,mlx5_1"
              },
              {
                "name": "NCCL_IB_TC",
                "value": "41"
              },
              {
                "name": "NCCL_SOCKET_IFNAME",
                "value": "eth0"
              }
            ],
            "resources": {},
            "volumeMounts": [
              {
                "name": "dshm",
                "mountPath": "/dev/shm"
              },
              {
                "name": "devinf",
                "mountPath": "/dev/infiniband"
              }
            ],
            "securityContext": {
              "capabilities": {
                "add": [
                  "IPC_LOCK"
                ]
              }
            }
          }
        ]
      },
      "status": {}
    }
  },
