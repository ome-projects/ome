  {
    "name": "probe profile with the default port",
    "pod": {
      "metadata": {
        "annotations": {
          "ome.io/enable-metric-aggregation": "false",
          "ome.io/enable-prometheus-scraping": "false",
          "runtime.ome.io/probe-profile": "sglang-http"
        }
      },
      "spec": {
        "containers": [
          {
            "name": "ome-container",
            "resources": {},
            "livenessProbe": {
              "httpGet": {
                "path": "/health",
                "port": 30000
              },
              "timeoutSeconds": 30,
              "periodSeconds": 60,
              "failureThreshold": 5
            },
            "readinessProbe": {
              "httpGet": {
                "path": "/health",
                "port": 30000
              },
              "initialDelaySeconds": 60,
              "timeoutSeconds": 30,
              "periodSeconds": 30,
              "successThreshold": 1,
              "failureThreshold": 5
            },
            "startupProbe": {
              "httpGet": {
                "path": "/health",
                "port": 30000
              },
              "initialDelaySeconds": 60,
              "timeoutSeconds": 30,
              "periodSeconds": 30,
              "failureThreshold": 60
            }
          }
        ]
      },
      "status": {}
    }
  },
